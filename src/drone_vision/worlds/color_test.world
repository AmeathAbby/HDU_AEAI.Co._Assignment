<?xml version="1.0"?>
<sdf version="1.6"><world name="default">
  <include><uri>model://sun</uri></include>
  <include><uri>model://ground_plane</uri></include>
  <physics name="default_physics" type="ode"><max_step_size>0.004</max_step_size><real_time_update_rate>250</real_time_update_rate></physics>
  <model name="red_target"><static>true</static><pose>3 1 0.6 0 0 0</pose>
    <link name="target">
      <collision name="collision"><geometry><box><size>0.3 1 1.2</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.3 1 1.2</size></box></geometry>
        <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse><specular>0 0 0 1</specular></material>
      </visual>
    </link>
  </model>
</world></sdf>
